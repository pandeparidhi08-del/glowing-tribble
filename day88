/*Q138: Print all enum names and integer values using a loop.

/*
Sample Test Cases:
Input 1:
No input
Output 1:
RED=0
YELLOW=1
GREEN=2

*/
#include <stdio.h>

enum Color {
    RED,
    YELLOW,
    GREEN
};

int main(void) {
    const char *names[] = {"RED", "YELLOW", "GREEN"};

    for (int value = RED; value <= GREEN; ++value) {
        printf("%s=%d\n", names[value], value);
    }

    return 0;
}
