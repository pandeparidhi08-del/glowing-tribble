/*Q110: Write a program to take an integer array arr and an integer k as inputs. The task is to find the maximum element in each subarray of size k moving from left to right. Print the maximum elements for each window separated by spaces as output.

/*
Sample Test Cases:
Input 1:
arr[1, 2, 3, 1, 4, 5, 2, 3, 6] = , k = 3
Output 1:
3 3 4 5 5 5 6

Input 2:
arr[5, 1, 3, 4, 2] = , k = 1
Output 2:
5 1 3 4 2

*/
#include <stdio.h>
#include <stdlib.h>

int main(void) {
    int n, k;
    scanf("%d", &n);

    int *arr = malloc(n * sizeof(int));
    if (arr == NULL) {
        return 1;
    }

    for (int i = 0; i < n; ++i) {
        scanf("%d", &arr[i]);
    }
    scanf("%d", &k);

    if (k <= 0 || k > n) {
        printf("-1\n");
        free(arr);
        return 0;
    }

    // Store indices in a deque. The front is the maximum for each window.
    int *deque = malloc(n * sizeof(int));
    if (deque == NULL) {
        free(arr);
        return 1;
    }

    int front = 0, back = 0;
    for (int i = 0; i < n; ++i) {
        while (front < back && deque[front] <= i - k) {
            ++front;
        }

        while (front < back && arr[deque[back - 1]] <= arr[i]) {
            --back;
        }
        deque[back++] = i;

        if (i >= k - 1) {
            if (i > k - 1) printf(" ");
            printf("%d", arr[deque[front]]);
        }
    }

    printf("\n");
    free(deque);
    free(arr);
    return 0;
}