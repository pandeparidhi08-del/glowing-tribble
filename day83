/*Q133: Create an enum for months and print how many days each month has.

/*
Sample Test Cases:
Input 1:
FEB
Output 1:
28 or 29 days

*/
#include <stdio.h>
#include <string.h>

enum Month {
    JAN, FEB, MAR, APR, MAY, JUN,
    JUL, AUG, SEP, OCT, NOV, DEC
};

int main(void) {
    char input[10];
    if (scanf("%9s", input) != 1) {
        return 1;
    }

    const char *names[] = {
        "JAN", "FEB", "MAR", "APR", "MAY", "JUN",
        "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"
    };

    enum Month month;
    for (month = JAN; month <= DEC; ++month) {
        if (strcmp(input, names[month]) == 0) {
            break;
        }
    }

    if (month > DEC) {
        printf("Invalid month\n");
        return 1;
    }

    const char *days[] = {
        "31 days", "28 or 29 days", "31 days", "30 days",
        "31 days", "30 days", "31 days", "31 days",
        "30 days", "31 days", "30 days", "31 days"
    };

    printf("%s\n", days[month]);
    return 0;
}