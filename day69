/*Q119: Write a program to take an integer array as input. Only one element will be repeated. Print the repeated element. Try to find the result in one single iteration.

/*
Sample Test Cases:
Input 1:
nums1 = [1,3,3,4]
Output 1:
3

Input 2:
nums1 = [1,2,2]
Output 2:
2

Input 3:
nums1 = [0,4,1,1,5]
Output 3:
1

*/
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>

static size_t hash_int(int value, size_t capacity) {
    uint32_t x = (uint32_t)value;
    x ^= x >> 16;
    x *= 0x7feb352dU;
    x ^= x >> 15;
    return (size_t)x & (capacity - 1);
}

int main(void) {
    int n;
    scanf("%d", &n);

    if (n <= 0) {
        return 0;
    }

    size_t capacity = 1;
    while (capacity < (size_t)n * 2) {
        capacity *= 2;
    }

    int *values = malloc(capacity * sizeof(int));
    char *occupied = calloc(capacity, sizeof(char));

    if (values == NULL || occupied == NULL) {
        free(values);
        free(occupied);
        return 1;
    }

    for (int i = 0; i < n; ++i) {
        int value;
        scanf("%d", &value);

        size_t index = hash_int(value, capacity);
        while (occupied[index] && values[index] != value) {
            index = (index + 1) & (capacity - 1);
        }

        if (occupied[index]) {
            printf("%d\n", value);
            free(values);
            free(occupied);
            return 0;
        }

        occupied[index] = 1;
        values[index] = value;
    }

    printf("-1\n");  // No repeated element found.
    free(values);
    free(occupied);
    return 0;
}
