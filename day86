/*Q136: Use enum to represent menu choices (ADD, SUBTRACT, MULTIPLY) and perform operations using switch.

/*
Sample Test Cases:
Input 1:
ADD 10 20
Output 1:
30

*/
#include <stdio.h>
#include <string.h>

enum Operation {
    ADD,
    SUBTRACT,
    MULTIPLY
};

int main(void) {
    char choice[20];
    int a, b;
    enum Operation operation;

    if (scanf("%19s %d %d", choice, &a, &b) != 3) {
        return 1;
    }

    if (strcmp(choice, "ADD") == 0) {
        operation = ADD;
    } else if (strcmp(choice, "SUBTRACT") == 0) {
        operation = SUBTRACT;
    } else if (strcmp(choice, "MULTIPLY") == 0) {
        operation = MULTIPLY;
    } else {
        printf("Invalid operation\n");
        return 1;
    }

    switch (operation) {
        case ADD:
            printf("%d\n", a + b);
            break;
        case SUBTRACT:
            printf("%d\n", a - b);
            break;
        case MULTIPLY:
            printf("%d\n", a * b);
            break;
    }

    return 0;
}